{
  "name": "@understudy/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Understudy AI layer — Analyst (permission classification) and Adjudicator (cutover readiness verdict).",
  "main": "src/agent/index.ts",
  "scripts": {
    "eval": "tsx evals/run.ts",
    "eval:roles": "tsx evals/run.ts --suite=roles",
    "eval:adjudication": "tsx evals/run.ts --suite=adjudication",
    "analyze": "tsx scripts/analyze-fixture.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "dotenv": "^17.0.0",
    "js-sha3": "^0.9.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
