# Copy to .env and fill in. .env is gitignored — never commit it.
#
# Only ANTHROPIC_API_KEY is needed to run the agent layer, the tests, and the
# eval suites. Everything below it is needed only to execute onchain.

# ── required for the agents ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Model the agents run on. Default is claude-opus-5. The published eval scores
# (89.7% / 100%) were measured on claude-haiku-4-5, which is what the live runs
# used. Any override must be Claude 4.6+ or older-family — the client shapes
# the request per family, see src/agent/client.ts.
UNDERSTUDY_MODEL=claude-haiku-4-5
UNDERSTUDY_FALLBACK_MODEL=claude-haiku-4-5
ANALYST_EFFORT=medium

# ── required to execute onchain ──────────────────────────────────────────
# Organisation key from app.keeperhub.com → Settings → API Keys.
KEEPERHUB_API_KEY=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ── required only to deploy your own demo contracts ──────────────────────
# A throwaway key with a little Sepolia ETH. Never a key you use elsewhere.
DEPLOYER_PRIVATE_KEY=

# ── filled in by the deploy step ─────────────────────────────────────────
# The keeper being retired. Nobody needs its key in a real migration — that is
# the whole point — but the demo uses one so it can build real call history.
DEAD_KEEPER=
DEAD_KEEPER_PRIVATE_KEY=
GUARDIAN=

# KeeperHub's wallet address — the incoming keeper. Read it from
# GET https://app.keeperhub.com/api/integrations
KH_WALLET=

# Deployed LegacyProtocol instances, by epoch/window pair.
VAULT=
TREASURY=
ORACLE=
SETTLER=
CYCLER=
